#
# Set ECHO_MODE to 'true' for test/echo mode (prompt is echoed as response)
# Set ECHO_MODE to 'false' or leave unset for real LLM completions
#
ECHO_MODE=false
# Example environment variables for LLM Gateway

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Default provider (openai or anthropic)
DEFAULT_PROVIDER=openai

# Path to pricing config (optional)
PRICING_PATH=pricing.yaml

# (Optional) Redis URL for caching
REDIS_URL=redis://localhost:6379/0
